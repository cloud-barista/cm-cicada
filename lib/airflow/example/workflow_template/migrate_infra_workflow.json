{
  "spec_version": "1.0",
  "name": "migrate_infra_workflow",
  "data": {
    "description": "Migrate Server",
    "task_groups": [
      {
        "name": "migrate_infra",
        "description": "Migrate Server",
        "tasks": [
          {
            "name": "infra_recommend_get",
            "task_component": "damselfly_task_get_cloud_infra_model",
            "spec": {
              "path_params": {
                "id": "89d6cc4b-555d-4004-838b-18709b0aeb2c"
              }
            },
            "dependencies": []
          },
          {
            "name": "infra_migration",
            "task_component": "beetle_task_infra_migration",
            "spec": {
              "request_body": "infra_recommend_get.cloudInfraModel",
              "path_params": {
                "nsId": "mig01"
              }
            },
            "dependencies": [
              "infra_recommend_get"
            ]
          },
          {
            "name": "sleep_for_1m_30s",
            "task_component": "cicada_task_time_sleep",
            "spec": {
              "request_body": "{\n  \"time\": \"1m 30s\"\n}"
            },
            "dependencies": [
              "infra_migration"
            ]
          },
          {
            "name": "send_result_via_email",
            "task_component": "trigger_email",
            "spec": {
              "conf": {
                "source_workflow_id": "{{ dag.dag_id }}",
                "source_workflow_run_id": "{{ dag_run.run_id }}",
                "to_email": "test@test.com"
              }
            },
            "dependencies": [
              "sleep_for_1m_30s"
            ]
          }
        ]
      }
    ]
  }
}
